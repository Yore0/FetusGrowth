# Required local paths. Do not commit real data or credentials.
MS_SWIFT_ROOT=/path/to/ms-swift
MODEL_PATH=/path/to/Qwen3.5-9B
SOURCE_ROOT=/private/path/to/source-data

# Optional output locations.
TRAIN_DATASET=/path/to/temporal-perinatal-outcome-vlm/data/train_continuous_v2_regression.jsonl
VAL_DATASET=/path/to/temporal-perinatal-outcome-vlm/data/val_continuous_clean_regression.jsonl
OUTPUT_DIR=/path/to/training-output

# Four-GPU reference configuration.
CUDA_VISIBLE_DEVICES=0,1,2,3
NPROC_PER_NODE=4
PER_DEVICE_TRAIN_BATCH_SIZE=6
PER_DEVICE_EVAL_BATCH_SIZE=2
GRAD_ACCUM_STEPS=2
NUM_TRAIN_EPOCHS=1
MAX_LENGTH=16384
